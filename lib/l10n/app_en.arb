  "techName_sbLineRegionConfinement": "Line trapped in a region",
  "@techName_sbLineRegionConfinement": {},
  "techWhy_sbLineRegionConfinement": "Every cell still open in this {line} {lineIndex} sits inside region {regionIndex}. The line's {stars} star(s) therefore come out of that region's quota, so the region's other cells are empty.",
