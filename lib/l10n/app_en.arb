  "tutorialTitle": "How to play",
  "@tutorialTitle": {},
  "tutorialStep1": "The goal is to place stars. Tap the highlighted cell to place one.",
  "@tutorialStep1": {},
  "tutorialStep2": "Stars are never neighbours — not even diagonally. See how the eight cells around it went grey? No star can go there.",
  "@tutorialStep2": {},
  "tutorialStep3": "Every row and every column holds exactly one star on this board. So the rest of that row and column just got crossed out too.",
  "@tutorialStep3": {},
  "tutorialStep4": "The coloured areas are regions, marked by the thick borders. Each region also holds exactly one star. That is what makes the puzzle interesting.",
  "@tutorialStep4": {},
  "tutorialStep5": "Now a real deduction. Tap the hint panel to see what the board can already prove.",
  "@tutorialStep5": {},
  "tutorialStep6": "That is the whole game: place a star, watch what it rules out, and find the cell that has no other option left.",
  "@tutorialStep6": {},
  "tutorialDone": "Finish",
  "@tutorialDone": {},
  "tutorialNext": "Next",
  "@tutorialNext": {},
  "tutorialSkip": "Skip",
  "@tutorialSkip": {},
  "tutorialWrongCell": "Not that one — try the highlighted cell.",
  "@tutorialWrongCell": {
    "description": "Gentle correction. The tutorial never blocks or scolds."
  },
  "tutorialTwoStarTitle": "Two stars per line",
  "@tutorialTwoStarTitle": {},
  "tutorialTwoStar1": "This board is different: every row, column and region holds TWO stars.",
  "@tutorialTwoStar1": {},
  "tutorialTwoStar2": "So one star does not finish its row. Watch — placing this one only blocks its neighbours.",
  "@tutorialTwoStar2": {},
  "tutorialTwoStar3": "Now the second star in that row. Only now does the rest of the row get crossed out, because the row has its full quota.",
  "@tutorialTwoStar3": {},
  "tutorialTwoStar4": "That is the one rule to carry over: a line clears when it is FULL, not when it has a star.",
  "@tutorialTwoStar4": {},

